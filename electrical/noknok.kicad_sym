		(property "Description" "2in 240x320 IPS TFT, ST7789V, 22-pin 0.5mm FPC (connector type). 4-wire SPI: WR=D/C, RS=SCK, SDA=MOSI. Strap IM2=H, IM1=H, IM0=L for 4-line serial. VCC 2.8-3.3V (internal power, only VCC+GND needed). Backlight = 3 parallel LEDs (LEDA common anode, LEDK common cathode), Vf 3.0V, If 45-60mA -> needs boost+CC driver. D7-D0/RD = parallel-only, leave open in SPI."
			(at 0 0 0)
			(hide yes)
			(effects
				(font
					(size 1.27 1.27)
				)
			)
		)

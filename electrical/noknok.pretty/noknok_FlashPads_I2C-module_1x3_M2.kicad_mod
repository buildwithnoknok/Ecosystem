(footprint "noknok_FlashPads_I2C-module_1x3_M2"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "noknok flashing interface for CH32V003 I2C modules. 3 single-side SMD pogo pads (1=GND, 2=SWIO, 3=3V3) on 2.54mm pitch, copper+mask only (NO paste). Embedded M2 (2.2mm NPTH) mounting hole 5.08mm from the GND pad fixes the hole-to-pad spacing and serves as the pogo-clamp orientation key. Authored on F.Cu - FLIP to bottom for bottom-side flashing. Forward-compatible with the shared 4-pogo jig (USB modules add SWCLK at the next grid step, X=7.62).")
	(tags "noknok flash pogo SWIO CH32V003 I2C programming testpad")

(footprint "noknok_Mezzanine_B_Pads_M2.5"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "noknok PicoHub mezzanine contact pads, interface rev 2 (22 Sep 2026), cluster B (8 flat round pads D2.4 mm, 3.5 mm pitch, copper + mask only - NO paste, ENIG; the spring pins live on the mezzanine): SPI port: SCK, GND, MISO, MEZZ_5V / MOSI, CS, IRQ, AIN. INCLUDES the M2.5 mounting hole H2 (2.5 mm NPTH, noknok standard) at its origin - this footprint replaces the plain hole at that corner of the 60x40 MOD-0008 pattern: place on the hub BOTTOM at the H2 position, rotation 0 (authored with y negated so the flip puts every pad at its viewed-from-above position). Mates with noknok_Mezzanine_B_PogoPins_BWCD_M2.5.")
	(tags "noknok mezzanine pogo pad PicoHub mountinghole M2.5")

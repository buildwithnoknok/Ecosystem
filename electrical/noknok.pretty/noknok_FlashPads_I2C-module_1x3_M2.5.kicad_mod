(footprint "noknok_FlashPads_I2C-module_1x3_M2.5"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "noknok flashing interface for CH32V003 I2C modules. Mounting hole at ORIGIN (0,0): M2.5, 2.5mm NPTH (Adafruit/Qwiic-aligned, nylon screw+standoff kit e.g. Adafruit 3299). 3 single-side SMD pogo pads (1=GND, 2=SWIO, 3=3V3) round Ø1.5mm on 2.54mm pitch, copper+mask only (NO paste); pad row offset +X from the hole and 1.5mm 'up' (Y=-1.5), GND-to-hole = 3.7mm so the hole/pad courtyards just touch. The embedded hole sets the hole-to-pad spacing AND is the pogo-clamp orientation key. Authored on F.Cu - FLIP to bottom for bottom-side flashing. Shared-jig geometry: USB modules reuse the same hole-to-pad offset and add SWCLK at +2.54 from 3V3. Place the hole >= ~2.25mm from the board edge (3mm preferred).")
	(tags "noknok flash pogo SWIO CH32V003 I2C programming testpad M2.5")
	(attr exclude_from_pos_files exclude_from_bom)
